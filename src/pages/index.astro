---
import PostList from '../components/PostList.astro';
import SiteShell from '../layouts/SiteShell.astro';
import { getPublishedPosts } from '../lib/blog';
import {
	CATEGORY_META,
	SITE_AUTHOR,
	SITE_COVER,
	SITE_DESCRIPTION,
	SITE_NAME,
	SITE_URL,
	formatPageTitle,
} from '../consts';

const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, 8);
const categoryLinks = Object.values(CATEGORY_META);
const homeSchema = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: SITE_NAME,
		url: `${SITE_URL}/`,
		description: SITE_DESCRIPTION,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Blog',
		name: SITE_NAME,
		url: `${SITE_URL}/`,
		description: SITE_DESCRIPTION,
		publisher: {
			'@type': 'Person',
			name: SITE_AUTHOR,
		},
	},
];
---

<SiteShell
	title={formatPageTitle()}
	description={SITE_DESCRIPTION}
	image={SITE_COVER}
	schema={homeSchema}
>
	<section class="hero hero--home">
		<div class="hero__content">
			<p class="hero__eyebrow">Tag</p>
			<h2>개발과 일상을 기록하는 개인 블로그입니다.</h2>
			<p class="hero__body">
				Swift와 iOS 개발 경험을 중심으로, 구현 과정에서 배운 점과 일상 기록을 차분하게 정리합니다.
			</p>
		</div>
	</section>

	<section class="home-section">
		<div class="home-section__header">
			<p class="page-intro__eyebrow">카테고리</p>
			<h3>주요 카테고리</h3>
		</div>
		<div class="category-links">
			{categoryLinks.map((item) => <a href={item.href}>{item.label}</a>)}
		</div>
	</section>

	<section class="home-section">
		<div class="home-section__header home-section__header--split">
			<div>
				<p class="page-intro__eyebrow">포스트</p>
				<h3>최근 글</h3>
			</div>
			<a class="home-section__link" href="/blog/">전체 글 보러가기</a>
		</div>
		<PostList posts={latestPosts} />
	</section>
</SiteShell>
