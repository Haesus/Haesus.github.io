---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { getCategoryHref, getCategoryLabel, getPostDescription, getTagHref } from '../lib/blog';

interface Props {
	post: CollectionEntry<'blog'>;
	featured?: boolean;
}

const { post, featured = false } = Astro.props;
const description = getPostDescription(post);
---

<article class:list={['post-card', { 'post-card--featured': featured }]}>
	<div class="post-card__meta">
		<span class="post-card__date"><FormattedDate date={post.data.pubDate} /></span>
		{
			post.data.category && (
				<a class="post-card__category" href={getCategoryHref(post.data.category)}>
					{getCategoryLabel(post.data.category)}
				</a>
			)
		}
	</div>
	<h2 class="post-card__title">
		<a href={`/blog/${post.id}/`}>{post.data.title}</a>
	</h2>
	<p class="post-card__description">{description}</p>
	{
		post.data.tags.length > 0 && (
			<ul class="post-card__tags">
				{post.data.tags.slice(0, 3).map((tag) => <li><a href={getTagHref(tag)}>{tag}</a></li>)}
			</ul>
		)
	}
</article>
