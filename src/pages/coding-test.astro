---
import PostList from '../components/PostList.astro';
import SiteShell from '../layouts/SiteShell.astro';
import { filterPostsByCategory, getPublishedPosts } from '../lib/blog';
import { formatPageTitle, SITE_DESCRIPTION } from '../consts';

const posts = filterPostsByCategory(await getPublishedPosts(), 'Coding-Test');
---

<SiteShell title={formatPageTitle('Coding Test')} description={SITE_DESCRIPTION}>
	<section class="page-intro">
		<p class="page-intro__eyebrow">Category</p>
		<h2>Coding Test</h2>
		<p>코딩 테스트를 진행하면서 풀이한 내용을 정리해두었습니다.</p>
	</section>
	<PostList posts={posts} />
</SiteShell>
