---
import SiteShell from '../layouts/SiteShell.astro';
import { formatPageTitle, SITE_AUTHOR, SITE_DESCRIPTION } from '../consts';
---

<SiteShell title={formatPageTitle('소개')} description={SITE_DESCRIPTION}>
	<section class="page-intro">
		<p class="page-intro__eyebrow">소개</p>
		<h2>{SITE_AUTHOR}</h2>
		<p>
			이 블로그는 개발 과정에서 배운 점과 일상적인 기록을 함께 남기기 위해 만들었습니다.
		</p>
	</section>
</SiteShell>
