---
import { ARCHIVE_ITEMS } from '../consts';

const pathname = Astro.url.pathname;
---

<nav class="archive-nav" aria-label="Archive navigation">
	<ul>
		{
			ARCHIVE_ITEMS.map((item) => (
				<li>
					<a href={item.href} class={pathname === item.href ? 'is-active' : undefined}>
						{item.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>
