---
import PostList from '../components/PostList.astro';
import SiteShell from '../layouts/SiteShell.astro';
import TopArchiveNav from '../components/TopArchiveNav.astro';
import { getPublishedPosts } from '../lib/blog';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = await getPublishedPosts();
---

<SiteShell title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<p class="hero__eyebrow">기술과 일상 기록</p>
		<h2>개인 기술 블로그와 일상 기록을 하나의 아카이브로 정리합니다.</h2>
		<p class="hero__body">
			Swift, SwiftUI, 코딩 테스트, 일상 회고를 가볍고 오래 남는 정적 블로그 구조로 쌓아갑니다.
		</p>
	</section>

	<TopArchiveNav />
	<PostList posts={posts.slice(0, 10)} featuredFirst={true} />
</SiteShell>
