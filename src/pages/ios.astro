---
import PostList from '../components/PostList.astro';
import SiteShell from '../layouts/SiteShell.astro';
import { filterPostsByCategory, getPublishedPosts } from '../lib/blog';
import { formatPageTitle, SITE_DESCRIPTION } from '../consts';

const posts = filterPostsByCategory(await getPublishedPosts(), 'IOS');
---

<SiteShell title={formatPageTitle('iOS')} description={SITE_DESCRIPTION}>
	<section class="page-intro">
		<p class="page-intro__eyebrow">Category</p>
		<h2>iOS</h2>
		<p>Apple, iOS, Swift 관련 기록을 모아둔 카테고리입니다.</p>
	</section>
	<PostList posts={posts} />
</SiteShell>
