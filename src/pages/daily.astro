---
import PostList from '../components/PostList.astro';
import SiteShell from '../layouts/SiteShell.astro';
import { filterPostsByCategory, getPublishedPosts } from '../lib/blog';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = filterPostsByCategory(await getPublishedPosts(), 'daily');
---

<SiteShell title={`${SITE_TITLE} | Daily`} description={SITE_DESCRIPTION}>
	<section class="page-intro">
		<p class="page-intro__eyebrow">Category</p>
		<h2>Daily</h2>
		<p>기록성 글, 회고, 사소한 생각들을 담는 카테고리입니다.</p>
	</section>
	<PostList posts={posts} />
</SiteShell>
